rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSharedMember() {
      return signedIn() && request.auth.uid in resource.data.memberUids;
    }

    function isSharedOwner() {
      return signedIn() && request.auth.uid == resource.data.ownerUid;
    }

    match /users/{uid} {
      allow read, write: if isUser(uid);

      match /shoppingLists/{listId} {
        allow read, write: if isUser(uid);
      }

      match /shoppingListDeletes/{listId} {
        allow read, write: if isUser(uid);
      }
    }

    match /sharedShoppingLists/{listId} {
      allow read: if isSharedMember();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if isSharedMember()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberUids == resource.data.memberUids;
      allow delete: if isSharedOwner();
    }
  }
}
