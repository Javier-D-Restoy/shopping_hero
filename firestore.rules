rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if signedIn() && (
        request.auth.uid == uid ||
        resource.data.email != null
      );
      allow list: if signedIn();
      allow create, update, delete: if isOwner(uid);

      match /shoppingLists/{listId} {
        allow read, write: if isOwner(uid);
      }

      match /shoppingListDeletes/{deleteId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /sharedShoppingLists/{listId} {
      allow list: if signedIn();
      allow get: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.memberUids
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
